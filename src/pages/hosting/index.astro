---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HOSTING_TITLE, HOSTING_DESCR, HOSTING_OG_IMAGE, HOSTING_H1 } from '../../consts';
import { hostingLogos } from '../../utils/logos';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const hostings = (await getCollection('hostingProviders'))
    .sort((a, b) => a.data.order - b.data.order);

const json_ld = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: hostings.map((h, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: h.data.name,
    })),
});
---

<BaseLayout title={HOSTING_TITLE} description={HOSTING_DESCR} og_image={HOSTING_OG_IMAGE} ld_json={json_ld}>
    <div class='mx-auto max-w-5xl px-5 py-12'>
        <header class='text-center'>
            <h1 class='text-3xl sm:text-4xl font-extrabold text-white text-balance'>{HOSTING_H1}</h1>
            <p class='mx-auto mt-4 max-w-2xl text-gray-400 leading-relaxed text-pretty'>
                Хостинги и VPS для самостоятельного размещения проектов.
            </p>
        </header>

        { hostings.length === 0 ? (
            <p class='mt-16 rounded-xl bg-brand-card px-6 py-12 text-center text-gray-400 ring-1 ring-white/5'>
                Список пока готовится.
            </p>
        ) : (
            <div class='mt-10 grid gap-5 lg:grid-cols-2'>
                { hostings.map((h, i) => (
                    <a
                        href={`/go/${h.id}`}
                        target='_blank'
                        rel='nofollow'
                        class='relative flex overflow-hidden rounded-xl bg-brand-card ring-1 ring-white/5 transition duration-200 hover:-translate-y-0.5 hover:ring-brand-accent/40'
                    >
                        <span class='ribbon'>{i + 1}</span>

                        <div class='flex w-32 shrink-0 items-center justify-center bg-white'>
                            { hostingLogos[h.id] ? (
                                <Image src={hostingLogos[h.id]} width={288} format='webp' alt='' class='block w-full' />
                            ) : (
                                <span class='text-4xl font-black text-brand-bg'>{h.data.name.charAt(0)}</span>
                            ) }
                        </div>

                        <div class='flex min-w-0 flex-1 flex-col gap-3 p-4'>
                            <div>
                                <h2 class='truncate pr-10 text-lg font-extrabold text-white'>{h.data.name}</h2>
                                <p class='mt-1 line-clamp-2 text-sm leading-relaxed text-gray-400'>{h.data.summary}</p>
                            </div>

                            <ul class='mt-auto flex flex-col gap-1.5 text-sm'>
                                { h.data.pros.map(item => (
                                    <li class='flex items-center gap-2 rounded-lg bg-green-500/5 px-2.5 py-1.5'>
                                        <span class='w-4 shrink-0 text-center text-lg font-extrabold leading-none text-green-400'>+</span>
                                        <span class='text-gray-300'>{item}</span>
                                    </li>
                                )) }
                                { h.data.cons.map(item => (
                                    <li class='flex items-center gap-2 rounded-lg bg-red-500/5 px-2.5 py-1.5'>
                                        <span class='w-4 shrink-0 text-center text-lg font-extrabold leading-none text-red-400'>−</span>
                                        <span class='text-gray-300'>{item}</span>
                                    </li>
                                )) }
                            </ul>
                            <span class='block rounded-lg bg-brand-accent px-4 py-2 text-center text-sm font-bold text-white'>Перейти</span>
                        </div>
                    </a>
                )) }
            </div>
        )}
    </div>
</BaseLayout>

<style>
    /* Шильдик-закладка с номером места */
    .ribbon {
        position: absolute;
        top: 0;
        right: 14px;
        z-index: 10;
        min-width: 1.6rem;
        padding: 5px 6px 12px;
        background: var(--color-brand-accent);
        color: #fff;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
        text-align: center;
        clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 76%, 0 100%);
    }
</style>
