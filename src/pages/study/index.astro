---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
    STUDY_TITLE, STUDY_DESCR, STUDY_OG_IMAGE, STUDY_H1, COURSE_H1, STACK_H1, LINK_STUDY, LINK_STACK, SITE_NAME,
} from '../../consts';
import ContactForm from '../../components/ContactForm.astro';
import { loadStack, plural } from '../../utils/stack';
import { Image } from 'astro:assets';
import stackImage from '../../assets/study/monitor.png';
import card1 from '../../assets/study/card_1.jpg';
import card2 from '../../assets/study/card_2.jpg';
import card3 from '../../assets/study/card_3.jpg';
import card4 from '../../assets/study/card_4.jpg';

const { directions, categories } = loadStack();
const techCount = categories.reduce((s, c) => s + c.techs.length, 0);
const url = (path: string) => new URL(path, Astro.site).href;

const audiences = [
    {
        title: 'Если только начинаете',
        points: [
            'Пошаговый путь от пустого компьютера до первого работающего проекта',
            'Объяснения без жаргона: что делает нейросеть, а что остаётся на вас',
            'Готовые настройки, чтобы не тратить недели на поиск рабочей связки',
        ],
    },
    {
        title: 'Если уже разрабатываете',
        points: [
            'Выбор харнеса под свои задачи и сравнение подходов',
            'Свои скилы: как упаковать повторяющиеся сценарии и переиспользовать их',
            'Git-приёмы, которые учитывают, как нейросеть меняет код',
        ],
    },
];

const steps = [
    {
        title: 'Доступ к топовым моделям из России',
        text: 'Как получить доступ к лучшим моделям без блокировок учёток и платить российскими картами или криптовалютой.',
    },
    {
        title: 'Настройка окружения',
        text: 'Собираем рабочее место для разработки с ИИ: инструменты, доступы и настройки, с которыми дальше ничего не мешает.',
    },
    {
        title: 'Что такое харнес и как его выбрать',
        text: 'Разбираемся, через что вы общаетесь с моделью, чем отличаются харнесы и какой подойдёт именно вам.',
    },
    {
        title: 'Подключаем скилы',
        text: 'Учимся расширять возможности агента готовыми скилами и понимать, когда они действительно нужны.',
    },
    {
        title: 'Пишем свои скилы',
        text: 'Превращаем повторяющиеся задачи в собственные скилы, чтобы агент делал их одинаково хорошо каждый раз.',
    },
    {
        title: 'Git в связке с нейросетью',
        text: 'Лайфхаки по работе с проектом через git с учётом того, как нейросеть читает, правит и откатывает код.',
    },
    {
        title: 'Полный алгоритм действий',
        text: 'Собираем всё в один повторяемый процесс разработки на топовых моделях — и многое другое по ходу курса.',
    },
];

const takeaways = [
    { title: 'Рабочее окружение', image: card1, text: 'Настроенное место для разработки с ИИ, которое работает из России без танцев с бубном.' },
    { title: 'Свой харнес', image: card2, text: 'Понимание, чем отличаются харнесы, и выбранный инструмент под ваши задачи.' },
    { title: 'Набор скилов', image: card3, text: 'Подключённые готовые скилы и первые собственные — под ваши повторяющиеся задачи.' },
    { title: 'Git-процесс под ИИ', image: card4, text: 'Привычки работы с репозиторием, при которых правки нейросети легко проверить и откатить.' },
];

const terminal = [
    { kind: 'cmd', text: 'agent' },
    { kind: 'out', text: 'Модель подключена · оплата: карта РФ' },
    { kind: 'cmd', text: '/skill add deploy' },
    { kind: 'ok', text: 'Скил deploy подключён' },
    { kind: 'cmd', text: 'Добавь форму записи и закоммить' },
    { kind: 'out', text: 'Читаю проект…' },
    { kind: 'ok', text: '3 файла изменено' },
    { kind: 'ok', text: 'Коммит «Форма записи»' },
];

const json_ld = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: SITE_NAME, item: url('/') },
                { '@type': 'ListItem', position: 2, name: STUDY_H1, item: url(LINK_STUDY) },
            ],
        },
        {
            '@type': 'Course',
            name: COURSE_H1,
            description: STUDY_DESCR,
            inLanguage: 'ru',
            provider: { '@type': 'Organization', name: SITE_NAME, url: url('/') },
            teaches: steps.map(s => s.title),
        },
    ],
});
---

<BaseLayout title={STUDY_TITLE} description={STUDY_DESCR} og_image={STUDY_OG_IMAGE} ld_json={json_ld}>
    <div class='course mx-auto max-w-screen-xl px-5 sm:px-10'>
        <section class='grid items-center gap-12 py-16 lg:grid-cols-[1.1fr_1fr] lg:py-24'>
            <div>
                <h1 class='text-4xl font-black tracking-[-0.02em] text-white text-balance sm:text-6xl'>{COURSE_H1.replace('-', '\u2011')}</h1>
                <p class='mt-6 max-w-[38rem] text-lg leading-relaxed text-gray-300 text-pretty'>
                    Авторский курс с полным алгоритмом действий: как разрабатывать на топовых моделях в российских реалиях —
                    без блокировок учёток, с оплатой российскими картами или криптовалютой.
                </p>
                <div class='mt-8 flex flex-wrap gap-3'>
                    <a href='#signup' class='course-btn course-btn-primary'>
                        Записаться
                        <svg viewBox='0 0 24 24' class='size-4' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' /></svg>
                    </a>
                    <a href='#program' class='course-btn course-btn-ghost'>Программа курса</a>
                </div>
                <p class='mt-4 text-sm text-gray-400'>Запишитесь заранее — и получите доступ к курсу одним из первых.</p>
            </div>

            <div class='term' aria-hidden='true'>
                <div class='flex items-center gap-1.5 border-b border-white/5 px-4 py-3'>
                    <span class='size-2.5 rounded-full bg-white/15'></span>
                    <span class='size-2.5 rounded-full bg-white/15'></span>
                    <span class='size-2.5 rounded-full bg-white/15'></span>
                </div>
                <div class='space-y-2 p-5 font-mono text-[13px] leading-relaxed sm:text-sm'>
                    { terminal.map((line, i) => (
                        <p class:list={['term-line', `term-${line.kind}`]} style={`--i:${i}`}>{line.text}</p>
                    )) }
                    <p class='term-line term-cursor' style={`--i:${terminal.length}`}></p>
                </div>
            </div>
        </section>

        <section class='py-12'>
            <h2 class='text-3xl font-extrabold tracking-[-0.02em] text-white sm:text-4xl'>Кому подойдёт</h2>
            <div class='mt-8 grid gap-x-16 gap-y-10 md:grid-cols-2'>
                { audiences.map(a => (
                    <div>
                        <h3 class='text-xl font-extrabold text-white'>{a.title}</h3>
                        <ul class='mt-4 flex flex-col gap-3'>
                            { a.points.map(p => (
                                <li class='flex gap-3 leading-relaxed text-gray-300'>
                                    <svg viewBox='0 0 24 24' class='mt-1 size-5 shrink-0 text-[var(--go)]' aria-hidden='true'><path d='M5 12.5l4.5 4.5L19 7.5' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' /></svg>
                                    <span>{p}</span>
                                </li>
                            )) }
                        </ul>
                    </div>
                )) }
            </div>
        </section>

        <section id='program' class='scroll-mt-8 py-16'>
            <div class='grid gap-12 lg:grid-cols-[1fr_1.6fr]'>
                <div class='lg:sticky lg:top-12 lg:self-start'>
                    <h2 class='text-3xl font-extrabold tracking-[-0.02em] text-white sm:text-4xl'>Программа</h2>
                    <p class='mt-4 max-w-md leading-relaxed text-gray-400 text-pretty'>
                        Семь шагов от доступа к моделям до собственного процесса разработки. Каждый следующий опирается на предыдущий.
                    </p>
                </div>

                <ol class='timeline relative' data-timeline>
                    <div class='timeline-track' aria-hidden='true'><div class='timeline-fill'></div></div>
                    { steps.map(s => (
                        <li class='timeline-step relative pb-12 pl-14 last:pb-0' data-step>
                            <span class='timeline-dot' aria-hidden='true'>
                                <svg viewBox='0 0 24 24' class='size-4'><path d='M5 12.5l4.5 4.5L19 7.5' fill='none' stroke='currentColor' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round' /></svg>
                            </span>
                            <h3 class='text-xl font-extrabold text-white'>{s.title}</h3>
                            <p class='mt-2 max-w-[60ch] leading-relaxed text-gray-400 text-pretty'>{s.text}</p>
                        </li>
                    )) }
                </ol>
            </div>
        </section>

        <section class='py-16'>
            <h2 class='text-3xl font-extrabold tracking-[-0.02em] text-white sm:text-4xl'>Что вы получите от курса</h2>
            <p class='mt-4 max-w-xl leading-relaxed text-gray-400'>Наведите или нажмите на карточку, чтобы перевернуть.</p>
            <div class='mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4'>
                { takeaways.map(t => (
                    <button type='button' class='flip' aria-pressed='false' data-flip>
                        <span class='flip-inner'>
                            <span class='flip-face flip-front'>
                                <Image src={t.image} width={640} format='webp' alt='' class='absolute inset-0 h-full w-full' />
                                <span class='flip-caption'>{t.title}</span>
                            </span>
                            <span class='flip-face flip-back'>
                                <span class='text-lg font-extrabold text-white'>{t.title}</span>
                                <span class='mt-3 leading-relaxed text-gray-300'>{t.text}</span>
                            </span>
                        </span>
                    </button>
                )) }
            </div>
        </section>

        <section class='py-16'>
            <h2 class='text-3xl font-extrabold tracking-[-0.02em] text-white sm:text-4xl'>Материалы</h2>
            <a
                href={LINK_STACK}
                class='mt-8 flex flex-col overflow-hidden rounded-xl bg-brand-card ring-1 ring-white/5 transition duration-200 hover:-translate-y-0.5 hover:ring-brand-accent/40 md:flex-row-reverse'
            >
                <div class='relative h-64 shrink-0 overflow-hidden sm:h-80 md:h-auto md:w-2/5'>
                    <Image src={stackImage} width={941} format='webp' alt='Страница статистики технологий в IT-вакансиях на экране монитора' class='absolute inset-0 h-full w-full object-cover' />
                </div>
                <div class='flex flex-1 flex-col justify-center p-6 sm:p-8'>
                    <h3 class='text-2xl font-extrabold text-white text-balance'>{STACK_H1}</h3>
                    <p class='mt-3 leading-relaxed text-gray-400 text-pretty'>
                        Какие технологии чаще всего требуют во фронтенде, бэкенде, DevOps, Data Science и мобильной разработке
                        и как меняется спрос на них по месяцам.
                    </p>
                    <p class='mt-4 text-sm text-gray-500'>
                        {directions.length} {plural(directions.length, ['направление', 'направления', 'направлений'])} ·
                        {techCount} {plural(techCount, ['технология', 'технологии', 'технологий'])}
                    </p>
                    <span class='mt-6 self-start rounded-lg bg-brand-accent px-5 py-2.5 text-sm font-bold text-white'>Смотреть статистику</span>
                </div>
            </a>
        </section>

        <section id='signup' class='my-16 scroll-mt-8 grid gap-10 rounded-2xl bg-brand-card px-6 py-10 ring-1 ring-white/5 sm:px-10 sm:py-12 lg:grid-cols-[1fr_1.1fr] lg:items-center'>
            <div>
                <h2 class='text-3xl font-extrabold tracking-[-0.02em] text-white text-balance sm:text-4xl'>
                    Будьте в числе первых, кто получит доступ
                </h2>
                <p class='mt-4 max-w-md leading-relaxed text-gray-400 text-pretty'>
                    Запишитесь сейчас — откроем вам курс одним из первых. В сообщении можно рассказать, что хотите разобрать: учтём при подготовке программы.
                </p>
            </div>
            <ContactForm formId='course' source='course' privacyUrl='/privacy/' submitText='Записаться' successText='Вы записаны! Напишем, как только откроем доступ к курсу.' />
        </section>
    </div>
</BaseLayout>

<style>
    .course {
        --go: oklch(0.74 0.17 152);
        --go-soft: oklch(0.74 0.17 152 / 0.18);
    }
    .course :global(::selection) {
        background: oklch(0.62 0.17 235 / 0.45);
        color: white;
    }
    .course :focus-visible {
        outline: 2px solid var(--go);
        outline-offset: 3px;
        border-radius: 8px;
    }

    .course-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 0.75rem;
        padding: 0.8rem 1.4rem;
        font-weight: 800;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s, box-shadow 0.2s;
    }
    .course-btn-primary {
        background: var(--color-brand-accent);
        color: white;
        box-shadow: 0 8px 24px -8px oklch(0.62 0.17 235 / 0.6);
    }
    .course-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px -8px oklch(0.62 0.17 235 / 0.7);
    }
    .course-btn-ghost {
        color: #e5e7eb;
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
    }
    .course-btn-ghost:hover {
        background: rgb(255 255 255 / 0.06);
    }

    .term {
        border-radius: 1rem;
        background: var(--color-brand-surface);
        box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8), inset 0 0 0 1px rgb(255 255 255 / 0.06);
    }
    .term-line {
        color: #9ca3af;
    }
    .term-cmd {
        color: #f3f4f6;
    }
    .term-cmd::before {
        content: '› ';
        color: var(--color-brand-accent);
    }
    .term-ok {
        color: var(--go);
    }
    .term-ok::before {
        content: '✓ ';
    }
    .term-cursor::after {
        content: '';
        display: inline-block;
        width: 0.55em;
        height: 1.1em;
        vertical-align: -0.2em;
        background: #f3f4f6;
        animation: term-blink 1s steps(1) infinite;
    }
    @media (prefers-reduced-motion: no-preference) {
        .term-line {
            opacity: 0;
            animation: term-in 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            animation-delay: calc(0.4s + var(--i) * 0.45s);
        }
    }
    @keyframes term-in {
        from { opacity: 0; transform: translateY(4px); filter: blur(3px); }
        to { opacity: 1; transform: none; filter: none; }
    }
    @keyframes term-blink {
        50% { opacity: 0; }
    }

    .timeline-track {
        position: absolute;
        left: 15px;
        top: 0.5rem;
        bottom: 0.5rem;
        width: 2px;
        border-radius: 2px;
        background: rgb(255 255 255 / 0.1);
        overflow: hidden;
    }
    .timeline-fill {
        width: 100%;
        height: var(--fill, 0px);
        background: var(--go);
        border-radius: 2px;
    }
    .timeline-dot {
        position: absolute;
        left: 0;
        top: 0;
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 999px;
        background: var(--color-brand-bg);
        color: transparent;
        box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.18);
        transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.4s, box-shadow 0.4s;
    }
    .timeline-step[data-done] .timeline-dot {
        background: var(--go);
        color: var(--color-brand-bg);
        box-shadow: 0 0 0 6px var(--go-soft);
    }
    .timeline-step h3 {
        transition: color 0.4s;
    }
    .timeline-step:not([data-done]) h3 {
        color: #d1d5db;
    }

    .flip {
        display: block;
        width: 100%;
        perspective: 1200px;
        text-align: left;
        cursor: pointer;
        border-radius: 1rem;
    }
    .flip-inner {
        position: relative;
        display: grid;
        aspect-ratio: 1;
        transform-style: preserve-3d;
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .flip-face {
        grid-area: 1 / 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 1rem;
        background: var(--color-brand-card);
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
        backface-visibility: hidden;
    }
    .flip-front {
        position: relative;
        justify-content: flex-end;
    }
    .flip-caption {
        position: relative;
        display: block;
        padding: 0.9rem 1.25rem;
        background: rgb(8 12 16 / 0.45);
        -webkit-backdrop-filter: blur(14px) saturate(1.2);
        backdrop-filter: blur(14px) saturate(1.2);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
        color: white;
        font-size: 1.125rem;
        font-weight: 800;
    }
    .flip-back {
        justify-content: center;
        padding: 1.5rem;
        transform: rotateY(180deg);
    }
    .flip[aria-pressed='true'] .flip-inner {
        transform: rotateY(180deg);
    }
    @media (hover: hover) {
        .flip:hover .flip-inner {
            transform: rotateY(180deg);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .flip-inner {
            transition: none;
        }
    }
</style>

<script>
    const timeline = document.querySelector<HTMLElement>('[data-timeline]');
    if (timeline) {
        const fill = timeline.querySelector<HTMLElement>('.timeline-fill')!;
        const steps = [...timeline.querySelectorAll<HTMLElement>('[data-step]')];
        let queued = false;

        const update = () => {
            queued = false;
            const line = innerHeight * 0.6;
            const rect = timeline.getBoundingClientRect();
            const progress = Math.max(0, Math.min(line - rect.top, rect.height));
            fill.style.setProperty('--fill', `${progress}px`);
            for (const step of steps) {
                step.toggleAttribute('data-done', step.getBoundingClientRect().top + 16 <= line);
            }
        };
        const schedule = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
        };
        addEventListener('scroll', schedule, { passive: true });
        addEventListener('resize', schedule);
        update();
    }

    for (const card of document.querySelectorAll<HTMLButtonElement>('[data-flip]')) {
        card.addEventListener('click', () => {
            card.setAttribute('aria-pressed', String(card.getAttribute('aria-pressed') !== 'true'));
        });
    }
</script>
