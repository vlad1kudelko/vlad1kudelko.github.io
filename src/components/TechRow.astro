---
import { formatInt, formatShare, type DirectionTech } from '../utils/stack';

interface Props {
    tech: DirectionTech;
}

const { tech: t } = Astro.props;
---

<li>
    <div class='flex items-baseline justify-between gap-3'>
        <span class='font-bold text-gray-100'>{t.name}</span>
        <span class='text-gray-200'>
            {formatShare(t.share)}
            <span class='ml-1.5 text-xs text-gray-500' title='Вакансий'>{formatInt(t.current!)}</span>
        </span>
    </div>
    <span class='mt-1 block h-1.5 overflow-hidden rounded-full bg-white/5'>
        <span class='block h-full rounded-full bg-brand-accent' style={`width:${(t.share * 100).toFixed(1)}%`}></span>
    </span>
</li>
